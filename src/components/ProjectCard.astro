---
import type { Project } from "../data/projects";

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<article class="project-card">

  {
    project.image && (
      <div class="project-image">
        <img
          src={project.image}
          alt={project.imageAlt || project.title}
          loading="lazy"
          style={{ objectFit: project.imageFit || "cover" }}
        />
      </div>
    )
  }

  <div class="project-content">

    <p class="category">{project.category}</p>

    <h2>{project.title}</h2>

    <div class="metadata">
      {project.organization && <span>{project.organization}</span>}
      {project.year && <span>{project.year}</span>}
    </div>

    <p class="description">
      {project.description}
    </p>

    {
      project.recognition && (
        <p class="recognition">
          {project.recognition}
        </p>
      )
    }

    <div class="technologies">
      {
        project.technologies.map((technology) => (
          <span class="tag">{technology}</span>
        ))
      }
    </div>

    {
      (project.github ||
        project.projectUrl ||
        project.presentationUrl) && (
        <div class="project-links">

          {
            project.github && (
              <a
                href={project.github}
                target="_blank"
                rel="noopener noreferrer"
              >
                GitHub ↗
              </a>
            )
          }

          {
            project.projectUrl && (
              <a
                href={project.projectUrl}
                target="_blank"
                rel="noopener noreferrer"
              >
                Project ↗
              </a>
            )
          }

          {
            project.presentationUrl && (
              <a
                href={project.presentationUrl}
                target="_blank"
                rel="noopener noreferrer"
              >
                Presentation ↗
              </a>
            )
          }

        </div>
      )
    }

  </div>
</article>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--background);
  }

  .project-image {
    aspect-ratio: 16 / 9;
    background: var(--surface);
  }

  .project-image img {
    width: 100%;
    height: 100%;
    display: block;
  }

  .project-content {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 1.6rem;
  }

  .category {
    margin: 0 0 0.75rem;
    color: var(--muted);
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  h2 {
    margin: 0 0 0.8rem;
    font-size: 1.65rem;
    line-height: 1.3;
  }

  .metadata {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1rem;
    margin-bottom: 1.2rem;
    color: var(--muted);
    font-size: 0.8rem;
  }

  .description {
    margin: 0 0 1.2rem;
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1.8;
  }

  .recognition {
    margin: 0 0 1rem;
    font-size: 0.8rem;
    font-weight: 600;
  }

  .technologies {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: auto;
  }

  .tag {
    padding: 0.25rem 0.6rem;
    background: var(--tag-background);
    color: var(--tag-foreground);
    border: 1px solid var(--tag-border);
    border-radius: 3px;
    font-size: 0.7rem;
  }

  .project-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    margin-top: 1.5rem;
  }

  .project-links a {
    font-size: 0.85rem;
    font-weight: 600;
  }

  .project-links a:hover {
    text-decoration: underline;
  }
</style>