---
import BaseLayout from "../../layouts/BaseLayout.astro";

import {
  projects,
  type Project,
} from "../../data/projects";

export function getStaticPaths() {
  return projects.map((project) => ({
    params: {
      slug: project.slug,
    },
    props: {
      project,
    },
  }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<BaseLayout
  title={project.title}
  description={project.description}
>
  <article class="project-detail">

    <a href="/projects/" class="back-link">
      ← All Projects
    </a>

    <header class="project-header">
      <p class="category">{project.category}</p>

      <h1>{project.title}</h1>

      <p class="description">
        {project.description}
      </p>

      <div class="technologies">
        {
          project.technologies.map((technology) => (
            <span class="tag">{technology}</span>
          ))
        }
      </div>
    </header>

    {
      project.image && (
        <div class="project-image">
          <img src={project.image} alt="" />
        </div>
      )
    }

    <section class="project-body">
      <h2>Overview</h2>

      <p>{project.description}</p>

      {
        (project.github || project.externalUrl) && (
          <div class="project-links">
            {
              project.github && (
                <a
                  href={project.github}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  GitHub ↗
                </a>
              )
            }

            {
              project.externalUrl && (
                <a
                  href={project.externalUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Project Website ↗
                </a>
              )
            }
          </div>
        )
      }
    </section>

  </article>
</BaseLayout>

<style>
  .project-detail {
    max-width: 850px;
    padding: 4rem 0 6rem;
  }

  .back-link {
    font-size: 0.9rem;
    color: var(--muted);
  }

  .project-header {
    margin: 4rem 0;
  }

  .category {
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 0.75rem;
    font-weight: 600;
  }

  h1 {
    margin: 1rem 0 1.5rem;
    font-size: clamp(2.7rem, 5vw, 4rem);
  }

  .description {
    color: var(--muted);
    font-size: 1.2rem;
    line-height: 1.8;
  }

  .technologies {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 2rem;
  }

  .tag {
    padding: 0.3rem 0.7rem;
    background: #f3f4f5;
    border-radius: 3px;
    font-size: 0.75rem;
  }

  .project-image img {
    width: 100%;
    border-radius: 6px;
  }

  .project-body {
    margin-top: 4rem;
  }

  .project-body h2 {
    margin-bottom: 1rem;
  }

  .project-body p {
    color: var(--muted);
    line-height: 1.9;
  }

  .project-links {
    display: flex;
    gap: 1.5rem;
    margin-top: 2rem;
  }

  .project-links a {
    font-weight: 600;
  }
</style>