---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectCard from "../../components/ProjectCard.astro";

import { projects } from "../../data/projects";
---

<BaseLayout
  title="Projects"
  description="Research and engineering projects in Earth observation, geospatial AI, remote sensing, and cloud computing."
>
  <section class="projects-page">

    <header class="page-header">
      <h1>Projects</h1>

      <p>
        Selected research and engineering projects spanning
        Earth observation, geospatial machine learning,
        environmental analytics, and cloud-based systems.
      </p>
    </header>

    <div class="project-grid">
      {
        projects.map((project) => (
          <ProjectCard project={project} />
        ))
      }
    </div>

  </section>
</BaseLayout>

<style>
  .projects-page {
    padding: 4rem 0 6rem;
  }

  .page-header {
    max-width: 750px;
    margin-bottom: 3.5rem;
  }

  h1 {
    margin: 0 0 1.25rem;
    font-size: clamp(2.8rem, 5vw, 4rem);
  }

  .page-header p {
    max-width: 700px;
    color: var(--muted);
    font-size: 1.05rem;
    line-height: 1.9;
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem;
    align-items: stretch;
  }

  @media (max-width: 768px) {
    .projects-page {
      padding: 3rem 0;
    }

    .project-grid {
      grid-template-columns: 1fr;
    }
  }
</style>