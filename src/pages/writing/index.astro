---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection(
  "writing",
  ({ data }) => !data.draft
)).sort(
  (a, b) =>
    b.data.date.getTime() - a.data.date.getTime()
);
---

<BaseLayout
  title="Writing"
  description="Technical notes and articles on Earth observation, geospatial computing, and machine learning."
>
  <section class="writing-page">
    <header class="page-header">
      <h1>Posts</h1>

      <p>
        Notes, technical articles, and explorations
        in Earth observation, geospatial analytics,
        machine learning, and data engineering.
      </p>
    </header>

    <div class="post-list">
      {
        posts.map((post) => (
          <article class="post-entry">
            <div class="post-date">
              <time datetime={post.data.date.toISOString()}>
                {post.data.date.toLocaleDateString("en-GB", {
                  year: "numeric",
                  month: "short",
                  timeZone: "UTC",
                })}
              </time>
            </div>

            <div class="post-content">
              <h2>
                <a href={`/writing/${post.id}/`}>
                  {post.data.title}
                </a>
              </h2>

              {
                post.data.description && (
                  <p>{post.data.description}</p>
                )
              }

              {
                post.data.tags.length > 0 && (
                  <div class="tags">
                    {post.data.tags.map((tag) => (
                      <span class="tag">{tag}</span>
                    ))}
                  </div>
                )
              }
            </div>
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .writing-page {
    max-width: 950px;
    padding: 4rem 0 6rem;
  }

  .page-header {
    max-width: 750px;
    margin-bottom: 3rem;
  }

  h1 {
    margin: 0 0 1.25rem;
    font-size: clamp(2.8rem, 5vw, 4rem);
  }

  .page-header p {
    color: var(--muted);
    font-size: 1.05rem;
    line-height: 1.9;
  }

  .post-list {
    border-top: 1px solid var(--border);
  }

  .post-entry {
    display: grid;
    grid-template-columns: 100px minmax(0, 1fr);
    gap: 2rem;
    padding: 2rem 0;
    border-bottom: 1px solid var(--border);
  }

  .post-date {
    padding-top: 0.35rem;
    color: var(--muted);
    font-size: 0.85rem;
  }

  h2 {
    margin: 0 0 0.75rem;
    font-size: 1.7rem;
    line-height: 1.35;
  }

  h2 a {
    text-decoration: none;
  }

  h2 a:hover {
    text-decoration: underline;
  }

  .post-content p {
    margin: 0 0 1rem;
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.8;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tag {
    color: var(--muted);
    font-size: 0.75rem;
  }

  .tag:not(:last-child)::after {
    content: " ·";
  }

  @media (max-width: 768px) {
    .writing-page {
      padding: 3rem 0;
    }

    .post-entry {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }
  }
</style>