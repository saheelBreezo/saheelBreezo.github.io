---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Home"
  description="Saheel Ahmed — Earth Observation, Geospatial AI, and Software Engineering."
>
  <section class="hero">
    <p class="eyebrow">
      EARTH OBSERVATION · GEOSPATIAL AI · DATA ENGINEERING
    </p>

    <h1>Hi, I'm Saheel!</h1>

    <div class="introduction">
      <p>
        I'm a geospatial data scientist and data engineer
        working at the intersection of satellite remote sensing,
        machine learning, and scalable geospatial systems.
      </p>

      <p>
        My work spans Earth observation analytics, GeoAI,
        interpretable machine learning, and cloud-based
        geospatial infrastructure.
      </p>
    </div>

    <div class="hero-actions">
      <a href="/projects/">Explore My Work →</a>
      <a href="/about/">More About Me →</a>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    max-width: 800px;
    padding: 7rem 0 5rem;
  }

  .eyebrow {
    color: var(--muted);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    font-weight: 600;
  }

  h1 {
    margin: 1.5rem 0 2.5rem;
    font-size: clamp(3rem, 6vw, 5rem);
  }

  .introduction {
    max-width: 720px;
  }

  .introduction p {
    color: var(--muted);
    font-size: 1.1rem;
    line-height: 1.9;
    margin-bottom: 1.5rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem;
    margin-top: 3rem;
  }

  .hero-actions a {
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
  }

  .hero-actions a:hover {
    text-decoration: underline;
  }

  @media (max-width: 768px) {
    .hero {
      padding: 4rem 0;
    }

    h1 {
      font-size: 3rem;
    }

    .introduction p {
      font-size: 1rem;
    }
  }
</style>